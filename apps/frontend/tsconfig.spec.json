{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "commonjs",
    "moduleResolution": "node",
    "rootDir": ".",
    "outDir": "./.test-dist",
    "noEmit": false,
    "incremental": false,
    "types": ["node", "react", "react-dom"]
  },
  "include": [
    "src/browser/**/*.ts",
    "src/components/**/*.tsx",
    "test/**/*.ts",
    "test/**/*.tsx"
  ],
  "exclude": ["node_modules", ".next", ".test-dist"]
}

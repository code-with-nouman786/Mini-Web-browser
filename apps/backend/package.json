{
  "name": "@wyxan/backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "seed": "npm run build && node dist/seed.js",
    "start": "node dist/main.js",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.spec.json --noEmit",
    "test": "node -e \"require('node:fs').rmSync('.test-dist', { recursive: true, force: true })\" && tsc -p tsconfig.spec.json && node --test \".test-dist/test/*.spec.js\""
  },
  "dependencies": {
    "@nestjs/common": "12.4.2",
    "@nestjs/config": "12.1.1",
    "@nestjs/core": "12.4.2",
    "@nestjs/mongoose": "12.0.1",
    "@nestjs/platform-express": "12.4.2",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "mongoose": "9.12.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sanitize-html": "2.18.1"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.12",
    "@types/sanitize-html": "2.16.2",
    "typescript-eslint": "^8.0.0"
  }
}
